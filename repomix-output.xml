<file path="Caleta_Guillermo/lacaleta/src/main/resources/static/style/styles.css">
/* 1. Paleta de colores y variables */
:root {
    --color-rojo-naranja: rgb(255, 69, 0);
    --color-carmesi: rgb(187, 20, 53);
    --color-blanco: rgb(255, 255, 255);
    --color-negro: rgb(24, 24, 24);
    --color-negro-suave: rgb(35, 35, 35);
    --transicion: all 0.3s ease;
}

body {
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    background-color: var(--color-negro);
    color: var(--color-blanco);
}

a {
    text-decoration: none;
    color: inherit;
    transition: var(--transicion);
}

/* 2. Secciones con fondos personalizados */
#topbar {
    background-color: var(--color-carmesi);
    font-size: 14px;
}

#header {
    background-color: var(--color-negro);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

#descripcion {
    background-color: rgb(146, 31, 2);
}

#principales {
    background-color: var(--color-negro);
}

/* 3. Banner principal */
#banner {
    min-height: 360px;
    background-image: url('../images/banner.jpg');
    background-size: cover;
    background-position: center;
}

#banner::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(24, 24, 24, 0.75) 0%, rgba(24, 24, 24, 0.5) 100%);
    z-index: 1;
}

.banner-contenido {
    position: relative;
    z-index: 2;
}

.banner-titulo {
    color: var(--color-rojo-naranja);
    text-shadow: 0 0 20px rgba(255, 69, 0, 0.6);
    letter-spacing: 2px;
}

/* 4. Botones y enlaces especiales */
.btn-cta {
    background-color: var(--color-rojo-naranja);
    color: var(--color-blanco);
    border-radius: 30px;
    box-shadow: 0 4px 15px rgba(255, 69, 0, 0.4);
}

.btn-cta:hover {
    background-color: rgb(255, 90, 20);
    transform: translateY(-2px);
    color: #fff;
}

.nav-menu-link-shop {
    background-color: var(--color-rojo-naranja);
    color: var(--color-blanco);
}

.btn-add-caleta {
    width: 36px;
    height: 36px;
    background-color: var(--color-rojo-naranja);
    color: var(--color-carmesi);
    border: none;
    transition: var(--transicion);
}

.btn-add-caleta:hover {
    background-color: var(--color-carmesi);
    color: var(--color-blanco);
}

/* 5. Tarjetas de pizza y carrusel continuo */
.carrusel-horizontal {
    scrollbar-width: none;
    scroll-behavior: smooth;
}

.carrusel-horizontal::-webkit-scrollbar {
    display: none;
}

.tarjeta-pizza {
    flex: 0 0 250px;
    width: 250px;
}

.contenedor-login {
    width: 100%;
    min-height: calc(100vh - 160px);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 30px 15px;
    background-color: var(--color-negro);
}

.login-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    max-width: 900px;
    background-color: #f7f7f7;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.45);
}

.login-seccion {
    padding: 35px 30px;
    display: flex;
    flex-direction: column;
}

.login-izq {
    background-color: var(--color-blanco);
    border-right: 1px solid #e5e5e5;
}

.login-der {
    justify-content: space-between;
}

.login-titulo {
    font-size: 24px;
    font-weight: 900;
    color: var(--color-negro);
    text-align: center;
    letter-spacing: 0.5px;
    margin-bottom: 20px;
}

.username {
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.username label {
    font-size: 13px;
    font-weight: 600;
    color: #374151;
}

.username label span {
    color: var(--color-carmesi);
}

.input-relative {
    position: relative;
    width: 100%;
}

.username input {
    width: 100%;
    height: 42px;
    padding: 8px 12px;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    font-size: 14px;
    color: var(--color-negro);
    background-color: #fff;
    outline: none;
    transition: var(--transicion);
}

.username input:focus {
    border-color: var(--color-rojo-naranja);
}

.username input::placeholder {
    color: #9ca3af;
}

.icono-ojo {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #6b7280;
    cursor: pointer;
}

.recordar {
    font-size: 13px;
    color: var(--color-carmesi);
    font-weight: 600;
    cursor: pointer;
    margin: 4px 0 20px 0;
    width: fit-content;
}

.recordar:hover {
    color: var(--color-rojo-naranja);
    text-decoration: underline;
}

.btn-login,
.btn-crear-cuenta {
    width: 100%;
    height: 44px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.5px;
    border-radius: 4px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: var(--transicion);
}

.btn-login {
    background-color: var(--color-rojo-naranja);
    color: var(--color-blanco);
    box-shadow: 0 4px 12px rgba(255, 69, 0, 0.3);
}

.btn-login:hover {
    background-color: rgb(255, 90, 20);
}

.btn-crear-cuenta {
    background-color: var(--color-negro-suave);
    color: var(--color-blanco);
    margin-top: 20px;
}

.btn-crear-cuenta:hover {
    background-color: var(--color-carmesi);
}

.beneficios-subtitulo {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-negro);
    margin-bottom: 12px;
}

.beneficios-lista {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.beneficios-lista li {
    font-size: 13px;
    color: #4b5563;
    line-height: 1.3;
    position: relative;
    padding-left: 16px;
}

.beneficios-lista li::before {
    content: "•";
    color: var(--color-rojo-naranja);
    font-size: 18px;
    position: absolute;
    left: 0;
    top: -3px;
}

footer {
    background-color: var(--color-negro-suave);
    padding: 20px 0;
    text-align: center;
    font-size: var(--texto-3);
    color: rgba(255, 255, 255, 0.6);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
}

@media (max-width: 768px) {
    .login-grid {
        grid-template-columns: 1fr;
    }

    .login-izq {
        border-right: none;
        border-bottom: 1px solid #e5e5e5;
    }
}

.btn-carrusel {
    width: 40px;
    height: 40px;
    background-color: var(--color-negro-suave);
    color: var(--color-blanco);
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: var(--transicion);
}

.btn-carrusel:hover {
    background-color: var(--color-rojo-naranja);
    color: var(--color-blanco);
    border-color: var(--color-rojo-naranja);
}

.buscador-input {
    background-color: var(--color-negro-suave);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--color-blanco);
    border-radius: 30px;
    font-size: 14px;
    transition: var(--transicion);
}

.buscador-input:focus {
    background-color: var(--color-negro-suave);
    border-color: var(--color-rojo-naranja);
    color: var(--color-blanco);
    box-shadow: 0 0 10px rgba(255, 69, 0, 0.35);
}

.buscador-input::placeholder {
    color: rgba(255, 255, 255, 0.45);
}

.btn-buscar:hover {
    color: var(--color-rojo-naranja) !important;
}

.accordion-button::after {
    filter: invert(1) grayscale(100%);
    transition: transform 0.3s ease;
}

.accordion-button:not(.collapsed)::after {
    filter: invert(36%) sepia(98%) saturate(3025%) hue-rotate(1deg) brightness(101%) contrast(105%);
}

.accordion-button:not(.collapsed) {
    color: var(--color-rojo-naranja) !important;
}

#categorias {
    background-color: rgba(24, 24, 24, 0.95);
    backdrop-filter: blur(8px);
    border-color: rgba(255, 255, 255, 0.1) !important;
    z-index: 1020;
}

.categorias-scroll {
    scrollbar-width: none;
}

.categorias-scroll::-webkit-scrollbar {
    display: none;
}

.btn-categoria {
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.75);
    background-color: var(--color-negro-suave);
    border: 1px solid rgba(255, 255, 255, 0.1);
