    const wrapTarjeta = document.getElementById('wrapper-tarjeta');
    const wrapYape = document.getElementById('wrapper-yape');

    if (metodo === 'tarjeta') {
        boxTarjeta.classList.remove('d-none');
        boxYape.classList.add('d-none');
