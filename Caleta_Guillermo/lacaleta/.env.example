# Copiar a .env en la carpeta del proyecto. Spring Boot lo importa como .properties.
# DATABASE_URL es una URL JDBC, sin usuario ni contraseña incrustados.
DATABASE_URL=jdbc:postgresql://HOST-POOLER/BASE?sslmode=require
DATABASE_DIRECT_URL=jdbc:postgresql://HOST-DIRECTO/BASE?sslmode=require
DATABASE_USERNAME=usuario
DATABASE_PASSWORD=reemplazar
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=correo@ejemplo.com
MAIL_PASSWORD=clave-de-aplicacion
DDL_AUTO=validate
